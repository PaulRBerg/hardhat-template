{
  "compilerOptions": {
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["es2023", "dom"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "resolveJsonModule": true,
    "strict": true,
    "target": "es2023"
  },
  "exclude": ["node_modules"],
  "include": ["hardhat.config.ts", "tasks/**/*", "test/**/*", "deploy/**/*", "rocketh/**/*", "types/**/*"]
}
