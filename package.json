{
  "name": "@prb/hardhat-template",
  "description": "Hardhat-based template for developing Solidity smart contracts",
  "version": "1.0.0",
  "author": {
    "name": "Paul Razvan Berg",
    "url": "https://github.com/PaulRBerg"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nomicfoundation/hardhat-ethers": "^4.2.1",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.13",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.12",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@nomicfoundation/hardhat-typechain": "^3.1.3",
    "@nomicfoundation/hardhat-verify": "^3.1.4",
    "@rocketh/deploy": "^0.20.1",
    "@rocketh/node": "^0.21.4",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@typechain/ethers-v6": "^0.5.1",
    "@types/chai": "^5.2.3",
    "@types/fs-extra": "^11.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "chai": "^6.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "ethers": "^6.17.0",
    "fs-extra": "^11.4.1",
    "hardhat": "^3.21.0",
    "hardhat-deploy": "^2.0.30",
    "lodash": "^4.18.1",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "prettier-plugin-solidity": "^2.4.1",
    "rimraf": "^6.1.3",
    "rocketh": "^0.23.1",
    "solhint": "^6.2.5",
    "solhint-plugin-prettier": "^0.1.0",
    "typechain": "^8.3.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "files": [
    "contracts"
  ],
  "keywords": [
    "blockchain",
    "ethers",
    "ethereum",
    "hardhat",
    "smart-contracts",
    "solidity",
    "template",
    "typescript",
    "typechain"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "hardhat clean && rimraf ./coverage ./types && bun run typechain",
    "compile": "hardhat compile",
    "coverage": "hardhat test mocha --coverage",
    "deploy:contracts": "hardhat deploy",
    "lint": "bun run lint:sol && bun run lint:ts && bun run prettier:check",
    "lint:sol": "solhint --max-warnings 0 \"contracts/**/*.sol\"",
    "lint:ts": "eslint .",
    "prettier:check": "prettier --check \"**/*.{js,mjs,json,md,sol,ts,yml}\"",
    "prettier:write": "prettier --write \"**/*.{js,mjs,json,md,sol,ts,yml}\"",
    "task:deployLock": "hardhat task:deployLock",
    "task:withdraw": "hardhat task:withdraw",
    "test": "hardhat test mocha",
    "typechain": "hardhat build"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "patchedDependencies": {
    "@nomicfoundation/hardhat-typechain@3.1.3": "patches/@nomicfoundation%2Fhardhat-typechain@3.1.3.patch"
  }
}
